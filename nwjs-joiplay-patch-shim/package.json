{
  "name": "nwjs-joiplay-patch-shim",
  "version": "1.0.0",
  "description": " A shim for patching JoiPlay in NW.js applications.",
  "type": "module",
  "bin": {
    "joiplay-shim": "./bin/joiplay-shim.js"
  },
