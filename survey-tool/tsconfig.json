{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "erasableSyntaxOnly": true,

    "allowJs": true,
    "checkJs": false
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "bin/**/*.js", "src/**/*.js"]
}
